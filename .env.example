# ==============================================================================
# ShopSphere Environment Configuration Template
# ==============================================================================
# Copy this file to .env (for local tools) or configure these environment
# variables directly in your cloud hosting provider's dashboard (Render, Railway, etc.).
#
# IMPORTANT: NEVER commit your actual .env file or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Runtime Profile
# ------------------------------------------------------------------------------
# Set to 'dev' for local development with local MySQL.
# Set to 'prod' for production cloud deployment with HTTPS, strict cookies, and reduced logs.
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL 8.0)
# ------------------------------------------------------------------------------
# Production JDBC URL. Ensure parameters: useSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://your-cloud-mysql-host:3306/shopsphere_db?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Production Database Credentials
DB_USERNAME=your_database_username
DB_PASSWORD=your_strong_database_password_here

# ------------------------------------------------------------------------------
# 3. Server Port Configuration
# ------------------------------------------------------------------------------
# Most cloud providers (Render, Railway, Heroku) inject the PORT environment variable automatically.
PORT=8080

# ------------------------------------------------------------------------------
# 4. Production Security & Admin Seed Override (Optional)
# ------------------------------------------------------------------------------
# Default admin account is seeded by Flyway migration V3:
# Email: admin@shopsphere.com
# Password: Change immediately upon initial production boot!
# APP_ADMIN_EMAIL=admin@yourdomain.com
# APP_ADMIN_PASSWORD=your_secure_random_admin_password
